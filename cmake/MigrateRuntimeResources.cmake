# Preserve deployed configuration and avoid copying the large model during migration.
if(NOT DEFINED RUNTIME_DIRECTORY OR NOT IS_DIRECTORY "${RUNTIME_DIRECTORY}")
    message(FATAL_ERROR "An existing RUNTIME_DIRECTORY is required")
endif()

file(REAL_PATH "${RUNTIME_DIRECTORY}" runtime_root)
file(MAKE_DIRECTORY "${runtime_root}/resources")
file(REAL_PATH "${runtime_root}/resources" resource_root)
if(NOT resource_root STREQUAL "${runtime_root}/resources")
    message(FATAL_ERROR "The resources directory must be inside the runtime directory")
endif()

foreach(resource_name IN ITEMS assistant opm)
    set(old_directory "${runtime_root}/${resource_name}")
    set(new_directory "${resource_root}/${resource_name}")
    if(IS_DIRECTORY "${old_directory}")
        file(REAL_PATH "${old_directory}" resolved_old_directory)
        if(NOT resolved_old_directory STREQUAL old_directory)
            message(FATAL_ERROR "Refusing to move a resource directory outside the runtime directory")
        endif()
        if(NOT EXISTS "${new_directory}")
            file(RENAME "${old_directory}" "${new_directory}")
        else()
            message(WARNING "Keeping legacy directory ${old_directory}: ${new_directory} already exists; no files were overwritten")
        endif()
    endif()
endforeach()
